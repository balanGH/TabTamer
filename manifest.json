{
  "manifest_version": 3,
  "name": "TabTamer",
  "version": "2.0.0",
  "version_name": "Blocker + Analytics v2",
  "description": "Track active tab and audio-playing tab time with session-based analytics, and temporarily block webpage elements.",
  "permissions": [
    "tabs",
    "storage",
    "notifications",
    "activeTab",
    "alarms",
    "scripting"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pages/blocked.html",
        "pages/blocked.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/contentToast.js",
        "src/content/contentBlocker.js",
        "src/content/contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}